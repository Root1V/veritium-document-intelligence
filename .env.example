# Copy to .env and adjust. Nothing here starts model-serving infrastructure —
# reasoning/vision settings must point at endpoints already running elsewhere
# (e.g. your own Prometheus serving project), OpenAI-compatible.

ENVIRONMENT=dev

# JWT auth (people and connected systems). With ENVIRONMENT=prod the API refuses to start on this default:
# generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-insecure-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
# Connected systems (VRT-65): token lifetime and default calls per minute.
API_CLIENT_TOKEN_MINUTES=15
API_CLIENT_RATE_LIMIT_PER_MINUTE=120

# Frontend dev server origin(s) allowed by CORS.
CORS_ALLOWED_ORIGINS=["http://localhost:5180"]

DATABASE_URL=postgresql+asyncpg://idp:idp@localhost:5433/idp

STORAGE_ENDPOINT_URL=http://localhost:9002
STORAGE_ACCESS_KEY=idp
STORAGE_SECRET_KEY=idp12345
STORAGE_BUCKET=idp-documents
STORAGE_REGION=us-east-1

# Inference (VRT-29): the only route to a model is synaptum -> axonium's SDK ->
# prometheus's gateway, with Veritium's prometheus client (client_credentials).
# Which model serves each role comes from that client's grants (GET
# /v1/models/mine): one text model (reasoning) and one vision model.
# axonium already knows the gateway URL.
AXONIUM_CLIENT_ID=
AXONIUM_CLIENT_SECRET=

LLM_REQUEST_TIMEOUT_SECONDS=180.0

PARSER_BACKEND=paddleocr
OCR_LANGUAGE=es

CLASSIFICATION_CONFIDENCE_THRESHOLD=0.6
EXTRACTION_MAX_TURNS=20
REVIEW_CONFIDENCE_THRESHOLD=0.75

ENTITY_MATCH_HIGH_THRESHOLD=0.90
ENTITY_MATCH_LOW_THRESHOLD=0.60

OTEL_SERVICE_NAME=idp
OTEL_CONSOLE_EXPORT=true

# Clave Fernet que cifra los secretos de firma de webhooks (VRT-28). Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# Event bus (VRT-49), optional: Kafka protocol (docker compose up -d redpanda).
# Without it, events go out by webhook and commands come in by POST /v1/events.
# EVENT_BUS_BROKERS=localhost:19092
# Claim-check: the only places a command may point documents to.
# CLAIM_CHECK_ALLOWED_PREFIXES=["s3://idp-documents/inbox/"]

# A2A server (VRT-52): EC P-256 private key (PEM) that signs the Agent Card.
# Required with ENVIRONMENT=prod; in development an ephemeral key is used.
# openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# A2A_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
